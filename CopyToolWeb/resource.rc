#include <winuser.h>
#include "webui_res.h"

1 24 "app.manifest"

/* ============================================================
   WebUI 前端资源：原样嵌入 exe（RCDATA），由 WebResourceRequested
   拦截器从内存响应，断网/无 WebUI 文件夹均可运行。
   路径相对本 .rc 所在目录（CopyToolWeb\）。
   ============================================================ */
IDR_WEBUI_INDEX          RCDATA "..\\WebUI\\index.html"
IDR_WEBUI_RENDERER_JS    RCDATA "..\\WebUI\\renderer.js"
IDR_WEBUI_BRIDGE_JS      RCDATA "..\\WebUI\\copytool-bridge.js"
IDR_WEBUI_UI_JS          RCDATA "..\\WebUI\\ui.js"
IDR_WEBUI_STYLES_CSS     RCDATA "..\\WebUI\\css\\styles.css"
IDR_WEBUI_MATERIALS_CSS  RCDATA "..\\WebUI\\css\\materials.css"
/* WebGL 已下线：desktop.js 与 shaders/*.glsl 保留在 WebUI 目录但不再嵌入/加载 */
